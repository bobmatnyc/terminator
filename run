#!/usr/bin/env bash
#
# TermPilot POC Runner Wrapper
#
# Usage:
#   ./run poc.hello_world
#   ./run poc.terminal_chatbot --demo
#   ./run poc.iterm2_control --demo
#   ./run poc.tmux_control --interactive
#
# This script activates the virtual environment and runs POC scripts
# via the Python runner module. Works from any directory.

set -e  # Exit on error

# Detect script directory (project root)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$SCRIPT_DIR"
VENV_PATH="$PROJECT_ROOT/.venv"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Check if virtual environment exists
if [ ! -d "$VENV_PATH" ]; then
    echo -e "${RED}Error: Virtual environment not found at $VENV_PATH${NC}"
    echo -e "${YELLOW}Please create one with:${NC}"
    echo -e "  cd $PROJECT_ROOT"
    echo -e "  python -m venv .venv"
    echo -e "  source .venv/bin/activate"
    echo -e "  pip install -e ."
    exit 1
fi

# Check if activation script exists
if [ ! -f "$VENV_PATH/bin/activate" ]; then
    echo -e "${RED}Error: Virtual environment activation script not found${NC}"
    echo -e "Expected: $VENV_PATH/bin/activate"
    exit 1
fi

# Activate virtual environment
# Note: We source in a subshell to avoid polluting parent shell
source "$VENV_PATH/bin/activate"

# Change to project root (required for Python module imports)
cd "$PROJECT_ROOT"

# Run the Python runner with all arguments passed through
# Using exec to replace the shell process and preserve exit codes
exec python -m scripts.runner "$@"
