# TermPilot Configuration

# Server
TERMPILOT_HOST=127.0.0.1
TERMPILOT_PORT=7777

# Default terminal adapter: "tmux" or "iterm2"
TERMPILOT_DEFAULT_ADAPTER=tmux

# LLM Configuration
TERMPILOT_OPENROUTER_API_KEY=
TERMPILOT_LOCAL_LLM_ENABLED=true
TERMPILOT_LOCAL_LLM_MODEL=qwen2.5-coder:1.5b

# Security
TERMPILOT_AUTH_TOKEN=
